{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehul0810/agent-harness/schemas/config.schema.json",
  "title": "Agent Harness Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectRoot"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectRoot": { "$ref": "#/$defs/projectPath" },
    "requiredFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/filePath" },
      "default": []
    },
    "requiredPhrases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phraseRule" },
      "default": []
    },
    "skillBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMaxWords", "files", "overrides"],
      "properties": {
        "defaultMaxWords": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        },
        "overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/filePath" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "routeBudgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/routeBudget" },
      "default": []
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" },
      "default": []
    },
    "behaviorBaselines": {
      "type": "array",
      "items": { "$ref": "#/$defs/behaviorBaseline" },
      "default": []
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "filePath": {
      "allOf": [
        { "$ref": "#/$defs/projectPath" },
        { "not": { "const": "." } }
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "phraseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "phrases"],
      "properties": {
        "file": { "$ref": "#/$defs/filePath" },
        "phrases": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "routeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maxWords", "files"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maxWords": { "type": "integer", "minimum": 1 },
        "warningPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "requiredPhrases"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "$ref": "#/$defs/filePath" },
        "requiredPhrases": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "behaviorScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256Scope", "files", "fixtureFiles", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256Scope": { "const": "full-contract-v2" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        },
        "fixtureFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "behaviorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runRecord", "runRecordSha256", "testedSourceSha256", "testedScenarioSha256"],
      "properties": {
        "runRecord": { "$ref": "#/$defs/filePath" },
        "runRecordSha256": { "$ref": "#/$defs/sha256" },
        "testedSourceSha256": { "$ref": "#/$defs/sha256" },
        "testedScenarioSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "telemetryBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "required": { "type": "boolean" },
        "max": { "type": "number", "minimum": 0 },
        "baseline": { "type": "number", "minimum": 0 },
        "maxRegressionPercent": { "type": "number", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["max"] },
        { "required": ["baseline", "maxRegressionPercent"] }
      ]
    },
    "behaviorBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceFiles", "sourceSha256", "scenario", "requiredChecks", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "scenario": { "$ref": "#/$defs/behaviorScenario" },
        "requiredChecks": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "telemetryBudgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/telemetryBudget" }
        },
        "evidence": { "$ref": "#/$defs/behaviorEvidence" }
      }
    }
  }
}
