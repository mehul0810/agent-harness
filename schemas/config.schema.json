{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehul0810/agent-harness/schemas/config.schema.json",
  "title": "Agent Harness Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectRoot"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectRoot": { "$ref": "#/$defs/projectPath" },
    "requiredFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/filePath" },
      "default": []
    },
    "requiredPhrases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phraseRule" },
      "default": []
    },
    "skillBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMaxWords", "files", "overrides"],
      "properties": {
        "defaultMaxWords": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        },
        "overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/filePath" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "routeBudgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/routeBudget" },
      "default": []
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" },
      "default": []
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "filePath": {
      "allOf": [
        { "$ref": "#/$defs/projectPath" },
        { "not": { "const": "." } }
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "phraseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "phrases"],
      "properties": {
        "file": { "$ref": "#/$defs/filePath" },
        "phrases": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "routeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maxWords", "files"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maxWords": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/filePath" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "requiredPhrases"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "$ref": "#/$defs/filePath" },
        "requiredPhrases": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
