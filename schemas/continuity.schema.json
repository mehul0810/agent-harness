{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private task continuity checkpoint",
  "description": "Bounded task data, not authority or a sanitized run record. Runtime additionally checks exact UTC timestamps, expiry <= 7 days, unique evidence IDs and source references, portable confined paths, evidence hashes, encoded size <= 32768 bytes, and caller-observed identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "sessionId",
    "workspaceId",
    "head",
    "branch",
    "modelId",
    "updatedAt",
    "expiresAt",
    "sections",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "head": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "modelId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "constraints",
        "decisions",
        "progress",
        "openRisks",
        "nextAction"
      ],
      "properties": {
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        },
        "openRisks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        },
        "nextAction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600,
              "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!.*\\u0000)[\\s\\S]*\\S[\\s\\S]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
